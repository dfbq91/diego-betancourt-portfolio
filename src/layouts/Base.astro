---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Software Engineer Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
    <script is:inline>
      const locale = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'es';
      const labels = {
        es: { about: 'Acerca de Mí', experience: 'Experiencia', projects: 'Proyectos', cv: 'Hoja de Vida', contact: 'Contacto', blog: 'Blog', backToBlog: 'Volver al Blog' },
        en: { about: 'About Me', experience: 'Experience', projects: 'Projects', cv: 'Resume', contact: 'Contact', blog: 'Blog', backToBlog: 'Back to Blog' },
      };

      document.documentElement.lang = locale;
      document.documentElement.dataset.locale = locale;
      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const key = element.getAttribute('data-i18n');
        if (key && labels[locale][key]) element.textContent = labels[locale][key];
      });
      if (locale === 'en') {
        document.querySelectorAll('a[href*="lang=es"]:not([data-locale-link])').forEach((link) => {
          const href = link.getAttribute('href');
          if (href) link.setAttribute('href', href.replace('lang=es', 'lang=en'));
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  html {
    scroll-behavior: smooth;
  }

  [data-language-content='en'] {
    display: none;
  }

  html[data-locale='en'] [data-language-content='es'] {
    display: none;
  }

  html[data-locale='en'] [data-language-content='en'] {
    display: grid;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  ::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
</style>

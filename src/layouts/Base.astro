---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Software Engineer Portfolio — Diego Betancourt' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      const locale = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'es';
      const labels = {
        es: { about: 'Acerca de Mí', experience: 'Experiencia', projects: 'Proyectos', chat: 'Chatea con Diego', cv: 'Hoja de Vida', contact: 'Contacto', blog: 'Blog', backToBlog: 'Volver al Blog' },
        en: { about: 'About Me', experience: 'Experience', projects: 'Projects', chat: 'Chat with Diego', cv: 'Resume', contact: 'Contact', blog: 'Blog', backToBlog: 'Back to Blog' },
      };

      document.documentElement.lang = locale;
      document.documentElement.dataset.locale = locale;
      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const key = element.getAttribute('data-i18n');
        if (key && labels[locale][key]) element.textContent = labels[locale][key];
      });
      document.querySelectorAll('a[href*="lang="]:not([data-locale-link])').forEach((link) => {
        const href = link.getAttribute('href');
        if (href) link.setAttribute('href', href.replace(/lang=(es|en)/g, `lang=${locale}`));
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

---
interface Props {
  title: string;
  excerpt: string;
  date: Date;
  slug: string;
  lang: string;
  dateFormat: string;
}

const { title, excerpt, date, slug, lang, dateFormat } = Astro.props;
const articleUrl = `/blog/${slug}?lang=${lang}`;
---

<!-- Editorial blog entry row — no card frame -->
<article
  style="
    border-bottom: 1px solid var(--color-border);
    padding: 1.75rem 0;
  "
>
  <a
    href={articleUrl}
    style="text-decoration: none; display: block;"
    aria-label={title}
  >
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <time
        class="t-metadata"
        style="color: var(--color-text-muted);"
        datetime={date.toISOString()}
      >
        {dateFormat}
      </time>
      <h3
        class="t-h2"
        style="
          transition: color 150ms ease-out;
          color: var(--color-text-primary);
        "
      >
        {title}
      </h3>
      <p class="t-body-small" style="max-width: 52rem;">
        {excerpt}
      </p>
    </div>
  </a>
</article>

<style>
  article a:hover h3 {
    color: var(--color-text-secondary);
  }
</style>

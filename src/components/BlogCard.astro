---
interface Props {
  title: string;
  excerpt: string;
  date: Date;
  slug: string;
  lang: string;
  dateFormat: string;
}

const { title, excerpt, date, slug, lang, dateFormat } = Astro.props;
const articleUrl = `/blog/${slug}?lang=${lang}`;
---

<article class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
  <a href={articleUrl} class="block">
    <h3 class="text-lg font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
      {title}
    </h3>
    <p class="text-gray-600 text-sm mb-4">{excerpt}</p>
    <div class="flex items-center justify-between">
      <time class="text-xs text-gray-500">{dateFormat}</time>
      <span class="text-sm text-blue-600 hover:text-blue-800">
        Read more →
      </span>
    </div>
  </a>
</article>

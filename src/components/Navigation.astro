---
import { getLocale, getTranslations, getAlternateUrl } from '../i18n/i18n';
import LanguageSelector from './LanguageSelector.astro';

const locale = getLocale(Astro.url);
const t = getTranslations(Astro.url);

const navItems = [
  { id: 'about',      num: '01' },
  { id: 'experience', num: '02' },
  { id: 'projects',   num: '03' },
  { id: 'chat',       num: '04' },
  { id: 'cv',         num: '05' },
  { id: 'contact',    num: '06' },
];

const getNavHref = (id: string) => `/?lang=${locale}#${id}`;
const blogHref = `/blog?lang=${locale}`;
const mindsetHref = `/mindset?lang=${locale}`;
const logoHref = `/?lang=${locale}`;
---

<!-- ============================================================
     Desktop: Full horizontal bar with terminal links
     Mobile: Hamburger with slide-out drawer
     ============================================================ -->
<header
  id="site-header"
  class="topbar sticky top-0 z-50 w-full border-b border-[var(--border)] transition-colors duration-150"
  aria-label="Navegación principal"
>
  <div class="max-w-[1200px] mx-auto px-6 sm:px-8 py-3.5 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a
      href={logoHref}
      class="flex items-center gap-2.5 font-mono text-[15px] font-semibold tracking-tight text-[var(--text-bright)] no-underline group"
      aria-label="Diego Betancourt — inicio"
    >
      <span
        class="size-2 shrink-0 rounded-full bg-[var(--accent)] shadow-[0_0_12px_var(--accent-glow)] animate-pulse-glow"
        aria-hidden="true"
      ></span>
      <span class="text-[var(--text-bright)] group-hover:text-[var(--accent)] transition-colors duration-150">diego</span>
      <span class="font-normal text-[var(--text-dim)]">.dev</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Secciones">
      <ul class="flex items-center gap-1 list-none m-0 p-0" role="list">
        {navItems.map(({ id, num }) => (
          <li>
            <a
              href={getNavHref(id)}
              data-section={id}
              class="nav-link px-3 py-1.5 font-mono text-[13px] rounded-md transition-all duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] flex items-center gap-1 text-[var(--text-dim)] no-underline"
            >
              <span
                class="nav-num text-[11px] opacity-40 mr-0.5"
                style="color: var(--text-dim); transition: color 150ms ease-out;"
              >
                ~/
              </span>
              <span
                class="nav-label t-nav"
                style="color: var(--text-dim); transition: color 150ms ease-out;"
                data-i18n={id}
              >
                {t.nav[id as keyof typeof t.nav]}
              </span>
            </a>
          </li>
        ))}

        <!-- Mindset Link -->
        <li>
          <a
            href={mindsetHref}
            class="px-3 py-1.5 font-mono text-[13px] rounded-md transition-all duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] flex items-center gap-1 text-[var(--text-dim)] no-underline"
          >
            <span class="text-[11px] opacity-40 mr-0.5" style="color: var(--text-dim);">~/</span>
            <span class="t-nav" data-i18n="mindset" style="color: var(--text-dim);">
              {t.nav.mindset}
            </span>
          </a>
        </li>

        <!-- Blog Link -->
        <li>
          <a
            href={blogHref}
            class="px-3 py-1.5 font-mono text-[13px] rounded-md transition-all duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] flex items-center gap-1 text-[var(--text-dim)] no-underline"
          >
            <span class="text-[11px] opacity-40 mr-0.5" style="color: var(--text-dim);">~/</span>
            <span class="t-nav" data-i18n="blog" style="color: var(--text-dim);">
              {t.nav.blog}
            </span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Right Controls: Language Selector, Theme Switcher & Mobile Menu Button -->
    <div class="flex items-center gap-3">
      <!-- Language Selector -->
      <div class="hidden sm:flex items-center px-2 py-1 rounded-md border border-[var(--border)] bg-[var(--surface)] text-[12px]">
        <LanguageSelector />
      </div>

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        class="flex items-center justify-center w-8 h-8 p-0 border border-[var(--border)] rounded-lg text-[var(--text-dim)] shrink-0 transition-colors duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)] cursor-pointer"
        aria-label="Cambiar tema"
        title="Toggle dark / light theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="menu-toggle"
        class="flex md:hidden items-center justify-center w-8 h-8 p-0 border border-[var(--border)] rounded-lg text-[var(--text-dim)] shrink-0 transition-colors duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)] cursor-pointer"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="icon-close" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Overlay Backdrop -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 z-40 bg-black/50 backdrop-blur-xs md:hidden transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Mobile Navigation Drawer -->
<aside
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-[280px] z-50 md:hidden flex flex-col border-l border-[var(--border)] bg-[var(--bg)] transition-transform duration-300 ease-in-out translate-x-full"
  aria-label="Menú móvil"
  aria-hidden="true"
>
  <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border)]">
    <div class="flex items-center gap-2 font-mono text-[14px] font-semibold text-[var(--text-bright)]">
      <span class="size-2 rounded-full bg-[var(--accent)] shadow-[0_0_8px_var(--accent-glow)]"></span>
      <span>diego.dev</span>
    </div>
    <button
      id="mobile-drawer-close"
      class="p-1 rounded-md text-[var(--text-dim)] hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] transition-colors"
      aria-label="Cerrar menú"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-1 p-4 overflow-y-auto" aria-label="Menú móvil de secciones">
    {navItems.map(({ id }) => (
      <a
        href={getNavHref(id)}
        class="mobile-nav-link block py-2.5 px-3 font-mono text-[14px] rounded-md transition-colors duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] text-[var(--text-dim)] no-underline"
      >
        <span class="opacity-40 mr-1.5">~/</span>
        <span data-i18n={id}>{t.nav[id as keyof typeof t.nav]}</span>
      </a>
    ))}
    <a
      href={mindsetHref}
      class="mobile-nav-link block py-2.5 px-3 font-mono text-[14px] rounded-md transition-colors duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] text-[var(--text-dim)] no-underline"
    >
      <span class="opacity-40 mr-1.5">~/</span>
      <span data-i18n="mindset">{t.nav.mindset}</span>
    </a>
    <a
      href={blogHref}
      class="mobile-nav-link block py-2.5 px-3 font-mono text-[14px] rounded-md transition-colors duration-150 hover:text-[var(--text-bright)] hover:bg-[var(--surface-2)] text-[var(--text-dim)] no-underline border-t border-[var(--border)] mt-2 pt-3"
    >
      <span class="opacity-40 mr-1.5">~/</span>
      <span data-i18n="blog">{t.nav.blog}</span>
    </a>
  </nav>

  <!-- Mobile Footer / Language -->
  <div class="mt-auto p-4 border-t border-[var(--border)] flex items-center justify-between text-[13px]">
    <span class="font-mono text-[11px] text-[var(--text-faint)]">LANGUAGE</span>
    <LanguageSelector />
  </div>
</aside>

<script>
  function setupNav() {
    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function syncThemeIcons() {
      const current = document.documentElement.dataset.theme;
      if (current === 'light') {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      } else {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      }
    }

    syncThemeIcons();

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.dataset.theme !== 'light';
      const newTheme = isDark ? 'light' : 'dark';
      document.documentElement.dataset.theme = newTheme;
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      syncThemeIcons();
    });

    // Mobile drawer toggle
    const menuToggle = document.getElementById('menu-toggle');
    const drawerClose = document.getElementById('mobile-drawer-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    function openMobile() {
      mobileMenu?.classList.remove('translate-x-full');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      menuToggle?.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMobile() {
      mobileMenu?.classList.add('translate-x-full');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      menuToggle?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    menuToggle?.addEventListener('click', () => {
      const isOpen = mobileMenu?.getAttribute('aria-hidden') === 'false';
      isOpen ? closeMobile() : openMobile();
    });

    drawerClose?.addEventListener('click', closeMobile);
    backdrop?.addEventListener('click', closeMobile);

    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMobile);
    });

    // Scroll spy: Update .nav-link active states
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            const isActive = link.getAttribute('data-section') === id;
            const label = link.querySelector('.nav-label') as HTMLElement | null;
            const num   = link.querySelector('.nav-num') as HTMLElement | null;

            if (label) {
              label.style.color = isActive ? 'var(--accent)' : 'var(--text-dim)';
            }
            if (num) {
              num.style.color = isActive ? 'var(--accent)' : 'var(--text-dim)';
              num.style.opacity = isActive ? '1' : '0.4';
            }
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });

    sections.forEach((section) => observer.observe(section));
  }

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>

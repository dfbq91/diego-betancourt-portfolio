---
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className = '' } = Astro.props;
---

<section
  id={id}
  class={`py-16 px-4 md:px-8 scroll-mt-16 ${className}`}
>
  <h2 class="text-2xl font-bold text-gray-900 mb-8 pb-2 border-b border-gray-200">
    {title}
  </h2>
  <slot />
</section>

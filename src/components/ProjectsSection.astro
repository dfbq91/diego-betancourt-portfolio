---
import { getLocale } from '../i18n/i18n';
import projectsEs from '../content/projects/projects.json';
import projectsEn from '../content/projects/projects.en.json';

interface Project {
  name: string;
  description: string;
  technologies: string[];
  demoUrl: string | null;
  repoUrl: string | null;
}

interface Props {
  title: string;
  demoLabel: string;
  repoLabel: string;
}

const { title, demoLabel, repoLabel } = Astro.props;
const locale = getLocale(Astro.url);
const projects: Project[] = locale === 'en' ? projectsEn : projectsEs;
---

<!-- ============================================================
     PROJECTS — T-10: Technical Case Studies
     Open rows structured as: Title → Description → Tech stack
     No card grids, no badge clouds
     ============================================================ -->
<section
  id="projects"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  "
  aria-labelledby="projects-heading"
>
  <!-- Section header -->
  <div style="margin-bottom: 3rem;">
    <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.75rem;">
      {locale === 'en' ? '03 // Projects' : '03 // Proyectos'}
    </p>
    <h2
      id="projects-heading"
      class="t-h1"
      data-i18n="projects"
    >
      {title}
    </h2>
  </div>

  <!-- Case study rows -->
  <div style="max-width: 52rem;">
    {projects.map((project, index) => {
      const isLast = index === projects.length - 1;
      return (
        <article
          style={`
            padding-bottom: 3rem;
            ${!isLast ? 'margin-bottom: 3rem; border-bottom: 1px solid var(--color-border);' : ''}
          `}
        >
          <!-- Project title + links -->
          <header style="margin-bottom: 1rem;">
            <div
              style="
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                gap: 0.5rem 1.5rem;
                margin-bottom: 0.5rem;
              "
            >
              <h3 class="t-h2">{project.name}</h3>
              <div style="display: flex; gap: 1rem; align-items: center;">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="t-label"
                    style="
                      color: var(--color-text-muted);
                      text-decoration: none;
                      transition: color 150ms ease-out;
                      display: inline-flex;
                      align-items: center;
                      gap: 0.25rem;
                    "
                    aria-label={`${project.name} — ${demoLabel}`}
                  >
                    {demoLabel} ↗
                  </a>
                )}
                {project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="t-label"
                    style="
                      color: var(--color-text-muted);
                      text-decoration: none;
                      transition: color 150ms ease-out;
                      display: inline-flex;
                      align-items: center;
                      gap: 0.25rem;
                    "
                    aria-label={`${project.name} — ${repoLabel}`}
                  >
                    {repoLabel} ↗
                  </a>
                )}
              </div>
            </div>
          </header>

          <!-- Description / context -->
          <p class="t-body-small" style="margin-bottom: 1.5rem; max-width: 48rem;">
            {project.description}
          </p>

          <!-- Tech stack — monospace inline metadata -->
          {project.technologies.length > 0 && (
            <div
              style="
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 1rem;
                align-items: center;
              "
            >
              <span class="t-metadata" style="color: var(--color-text-muted); margin-right: 0.5rem;">
                {locale === 'en' ? 'Stack' : 'Stack'}
              </span>
              {project.technologies.map((tech, i) => (
                <span>
                  <span
                    class="t-metadata"
                    style="color: var(--color-text-secondary);"
                  >
                    {tech}
                  </span>
                  {i < project.technologies.length - 1 && (
                    <span class="t-metadata" style="color: var(--color-text-muted); margin-left: 0.5rem;">·</span>
                  )}
                </span>
              ))}
            </div>
          )}
        </article>
      );
    })}
  </div>
</section>

---
import config from '../data/config.json';
import { getLocale } from '../i18n/i18n';

interface Props {
  title: string;
  linkedinLabel: string;
  githubLabel: string;
}

const { title, linkedinLabel, githubLabel } = Astro.props;
const locale = getLocale(Astro.url);
---

<!-- ============================================================
     CONTACT SECTION — T-13: Minimalist text links
     ============================================================ -->
<section
  id="contact"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 4rem 2.5rem 6rem;
  "
  aria-labelledby="contact-heading"
>
  <div style="max-width: 52rem;">
    <!-- Section header -->
    <div style="margin-bottom: 3rem;">
      <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.75rem;">
        {locale === 'en' ? '06 // Contact' : '06 // Contacto'}
      </p>
      <h2
        id="contact-heading"
        class="t-h1"
        data-i18n="contact"
      >
        {title}
      </h2>
    </div>

    <!-- Social links as text triggers -->
    <div
      style="
        display: flex;
        flex-direction: column;
        gap: 0;
        border-top: 1px solid var(--color-border);
      "
    >
      <a
        href={config.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        id="contact-linkedin"
        style="
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          padding: 1.25rem 0;
          border-bottom: 1px solid var(--color-border);
          text-decoration: none;
          color: var(--color-text-secondary);
          transition: color 150ms ease-out;
          gap: 1rem;
        "
        aria-label={`${linkedinLabel} — ${locale === 'en' ? 'opens in new tab' : 'abre en nueva pestaña'}`}
      >
        <span class="t-h2">{linkedinLabel}</span>
        <span class="t-metadata" style="color: var(--color-text-muted); flex-shrink: 0;">↗</span>
      </a>

      <a
        href={config.social.github}
        target="_blank"
        rel="noopener noreferrer"
        id="contact-github"
        style="
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          padding: 1.25rem 0;
          border-bottom: 1px solid var(--color-border);
          text-decoration: none;
          color: var(--color-text-secondary);
          transition: color 150ms ease-out;
          gap: 1rem;
        "
        aria-label={`${githubLabel} — ${locale === 'en' ? 'opens in new tab' : 'abre en nueva pestaña'}`}
      >
        <span class="t-h2">{githubLabel}</span>
        <span class="t-metadata" style="color: var(--color-text-muted); flex-shrink: 0;">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  #contact-linkedin:hover,
  #contact-github:hover {
    color: var(--color-text-primary);
  }
</style>

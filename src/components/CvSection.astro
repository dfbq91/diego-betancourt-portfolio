---
import config from '../data/config.json';
import { getLocale } from '../i18n/i18n';

interface Props {
  title: string;
  downloadLabel: string;
}

const { title, downloadLabel } = Astro.props;
const locale = getLocale(Astro.url);
---

<!-- ============================================================
     CV SECTION — T-13: Centralized config path, clean text trigger
     ============================================================ -->
<section
  id="cv"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  "
  aria-labelledby="cv-heading"
>
  <div style="max-width: 52rem;">
    <!-- Section header -->
    <div style="margin-bottom: 2.5rem;">
      <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.75rem;">
        {locale === 'en' ? '05 // Resume' : '05 // Hoja de Vida'}
      </p>
      <h2
        id="cv-heading"
        class="t-h1"
        data-i18n="cv"
      >
        {title}
      </h2>
    </div>

    <!-- CV download trigger -->
    <a
      href={config.cv.file}
      download
      id="cv-download"
      style="
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        border: 1px solid var(--color-border);
        padding: 0.875rem 1.5rem;
        color: var(--color-text-secondary);
        transition: color 150ms ease-out, border-color 150ms ease-out;
      "
      aria-label={`${downloadLabel} — PDF`}
    >
      <span class="t-label">
        {downloadLabel}
      </span>
      <span class="t-metadata" style="color: var(--color-text-muted);">↓ PDF</span>
    </a>
  </div>
</section>

<style>
  #cv-download:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }
</style>

---
import { getLocale, getAlternateUrl, type Locale } from '../i18n/i18n';

const currentLocale = getLocale(Astro.url);
---

<div class="flex items-center gap-2">
  <a
    data-locale-link
    href={getAlternateUrl(Astro.url, 'es')}
    class={`text-sm px-2 py-1 rounded transition-colors ${
      currentLocale === 'es'
        ? 'bg-blue-100 text-blue-700 font-medium'
        : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
    }`}
    aria-label="Cambiar a español"
  >
    ES
  </a>
  <span class="text-gray-300">|</span>
  <a
    data-locale-link
    href={getAlternateUrl(Astro.url, 'en')}
    class={`text-sm px-2 py-1 rounded transition-colors ${
      currentLocale === 'en'
        ? 'bg-blue-100 text-blue-700 font-medium'
        : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
    }`}
    aria-label="Switch to English"
  >
    EN
  </a>
</div>

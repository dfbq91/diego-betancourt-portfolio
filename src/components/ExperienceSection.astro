---
import { getLocale } from '../i18n/i18n';
import experienceEs from '../content/experience/experience.json';
import experienceEn from '../content/experience/experience.en.json';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string | null;
  description: string;
}

interface Props {
  title: string;
  presentLabel: string;
}

const { title, presentLabel } = Astro.props;
const locale = getLocale(Astro.url);
const experiences: Experience[] = (locale === 'en' ? experienceEn : experienceEs).sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + '-01');
  return date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-CO', {
    month: 'short',
    year: 'numeric',
  });
}

function parseBullets(description: string): string[] {
  return description.split('\n').filter(line => line.trim().startsWith('-')).map(line => line.replace(/^-\s*/, '').trim());
}
---

<!-- ============================================================
     Terminal header, clean cards, active status, accent prompts
     ============================================================ -->
<section
  id="experience"
  class="relative py-20 border-b border-[var(--border)] scroll-mt-20"
  aria-labelledby="experience-heading"
>
  <div class="max-w-[1200px] mx-auto">
    <!-- Section Header -->
    <div class="flex items-baseline justify-between gap-6 mb-10 pb-5 border-b border-[var(--border)]">
      <div>
        <div class="font-mono text-[12px] text-[var(--text-dim)] tracking-[0.06em]">
          <span class="text-[var(--accent)] mr-2">02</span>{locale === 'en' ? 'CAREER HISTORY' : 'TRAYECTORIA'}
        </div>
        <h2
          id="experience-heading"
          class="font-mono font-medium text-[clamp(26px,3.5vw,38px)] tracking-[-0.03em] text-[var(--text-bright)] mt-2 mb-0"
          data-i18n="experience"
        >
          {title}
        </h2>
      </div>

      <div class="font-mono text-[12px] text-[var(--text-dim)] text-right hidden sm:block">
        ~/experience<br />
        <span class="text-[var(--text-faint)]">{experiences.length} roles logged</span>
      </div>
    </div>

    <!-- Experience Cards / Timeline -->
    <div class="flex flex-col gap-6">
      {experiences.map((exp, index) => {
        const bullets = parseBullets(exp.description);
        const isCurrent = exp.endDate === null;
        const indexStr = String(index + 1).padStart(2, '0');

        return (
          <article class="tech-card flex flex-col p-6 rounded-xl border border-[var(--border)] bg-[var(--surface)] transition-all duration-200 hover:border-[var(--accent)]">
            <!-- Header row: Title, Company, Dates -->
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-4 mb-4">
              <div>
                <div class="flex items-center gap-2.5 mb-1.5">
                  <span class="font-mono text-[11px] text-[var(--accent)] tracking-[0.08em]">
                    [{indexStr}]
                  </span>
                  <h3 class="font-mono text-[19px] sm:text-[21px] font-medium text-[var(--text-bright)] tracking-tight">
                    {exp.position}
                  </h3>
                </div>
                <div class="font-mono text-[13px] text-[var(--text-dim)] flex items-center gap-2">
                  <span class="text-[var(--text)] font-medium">{exp.company}</span>
                  {isCurrent && (
                    <span class="px-2 py-0.5 rounded text-[10px] uppercase font-mono font-semibold tracking-wider bg-[var(--accent-dim)] text-[var(--accent)] border border-[var(--accent)]/30">
                      {locale === 'en' ? 'Active' : 'Actual'}
                    </span>
                  )}
                </div>
              </div>

              <!-- Date Badge -->
              <div class="font-mono text-[12px] text-[var(--text-dim)] shrink-0 self-start sm:self-auto bg-[var(--surface-2)] px-2.5 py-1 rounded border border-[var(--border)]">
                {formatDate(exp.startDate)} — {isCurrent ? presentLabel : formatDate(exp.endDate!)}
              </div>
            </div>

            <!-- Description / Bullets with Accent Prompt -->
            {bullets.length > 0 && (
              <ul class="flex flex-col gap-2.5 list-none m-0 p-0 pt-2 border-t border-dashed border-[var(--border)]">
                {bullets.map((item) => (
                  <li class="flex items-start gap-2.5 text-[14px] text-[var(--text)] leading-[1.6]">
                    <span class="font-mono text-[var(--accent)] select-none shrink-0 font-bold text-[13px] mt-0.5">›</span>
                    <span class="text-pretty">{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

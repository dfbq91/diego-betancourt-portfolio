---
import { getLocale } from '../i18n/i18n';
import experienceEs from '../content/experience/experience.json';
import experienceEn from '../content/experience/experience.en.json';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string | null;
  description: string;
}

interface Props {
  title: string;
  presentLabel: string;
}

const { title, presentLabel } = Astro.props;
const locale = getLocale(Astro.url);
const experiences: Experience[] = (locale === 'en' ? experienceEn : experienceEs).sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + '-01');
  return date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-CO', {
    month: 'short',
    year: 'numeric',
  });
}

function parseBullets(description: string): string[] {
  return description.split('\n').filter(line => line.trim().startsWith('-')).map(line => line.replace(/^-\s*/, '').trim());
}
---

<!-- ============================================================
     EXPERIENCE — T-9: Editorial Timeline
     Open vertical layout, no card grid wrappers
     ============================================================ -->
<section
  id="experience"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  "
  aria-labelledby="experience-heading"
>
  <!-- Section header -->
  <div style="margin-bottom: 3rem;">
    <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.75rem;">
      {locale === 'en' ? '02 // Experience' : '02 // Experiencia'}
    </p>
    <h2
      id="experience-heading"
      class="t-h1"
      data-i18n="experience"
    >
      {title}
    </h2>
  </div>

  <!-- Timeline entries -->
  <div style="max-width: 52rem;">
    {experiences.map((exp, index) => {
      const bullets = parseBullets(exp.description);
      const isLast = index === experiences.length - 1;
      const isCurrent = exp.endDate === null;
      return (
        <article
          style={`
            padding-bottom: 3rem;
            ${!isLast ? 'margin-bottom: 3rem; border-bottom: 1px solid var(--color-border);' : ''}
          `}
        >
          <!-- Role header -->
          <header style="margin-bottom: 1.25rem;">
            <div
              style="
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                justify-content: space-between;
                gap: 0.5rem 2rem;
                margin-bottom: 0.375rem;
              "
            >
              <h3 class="t-h2">{exp.position}</h3>
              <span
                class="t-metadata"
                style="color: var(--color-text-muted); white-space: nowrap;"
              >
                {formatDate(exp.startDate)}
                &nbsp;—&nbsp;
                {isCurrent ? presentLabel : formatDate(exp.endDate!)}
              </span>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <p
                class="t-body-small"
                style="color: var(--color-text-secondary); font-weight: 500;"
              >
                {exp.company}
              </p>
              {isCurrent && (
                <span
                  class="t-metadata"
                  style="
                    color: var(--color-text-primary);
                    border: 1px solid var(--color-border);
                    padding: 0.125rem 0.5rem;
                    border-radius: 1px;
                  "
                >
                  {locale === 'en' ? 'Current' : 'Actual'}
                </span>
              )}
            </div>
          </header>

          <!-- Bullet points -->
          {bullets.length > 0 && (
            <ul
              style="
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.625rem;
              "
            >
              {bullets.map((item) => (
                <li
                  class="t-body-small"
                  style="
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    color: var(--color-text-secondary);
                  "
                >
                  <span
                    class="t-metadata"
                    style="
                      color: var(--color-text-muted);
                      margin-top: 0.2em;
                      flex-shrink: 0;
                      user-select: none;
                    "
                  >
                    —
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      );
    })}
  </div>
</section>

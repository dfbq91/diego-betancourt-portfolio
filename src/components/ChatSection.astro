---
interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  welcome: string;
  inputLabel: string;
  placeholder: string;
  sendLabel: string;
  typingLabel: string;
  errorMessage: string;
  limitMessage: string;
}

const {
  title,
  eyebrow,
  intro,
  welcome,
  inputLabel,
  placeholder,
  sendLabel,
  typingLabel,
  errorMessage,
  limitMessage
} = Astro.props;
---

<!-- ============================================================
     CHAT SECTION — T-11: Editorial Q&A Document Box
     Monochrome, document-style. Backend untouched.
     ============================================================ -->
<section
  id="chat"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  "
  aria-labelledby="chat-title"
>
  <!-- Section header -->
  <div style="margin-bottom: 3rem; max-width: 52rem;">
    <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.75rem;">
      {eyebrow}
    </p>
    <h2 id="chat-title" class="t-h1" style="margin-bottom: 0.75rem;">
      {title}
    </h2>
    <p class="t-body-small" style="max-width: 36rem;">
      {intro}
    </p>
  </div>

  <!-- Q&A document box -->
  <div
    style="max-width: 52rem;"
    data-chat
    data-typing-label={typingLabel}
    data-error-message={errorMessage}
    data-limit-message={limitMessage}
  >
    <!-- Status bar -->
    <div
      style="
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 1.5rem;
      "
    >
      <span
        style="
          width: 0.5rem;
          height: 0.5rem;
          border-radius: 50%;
          background: var(--color-text-muted);
          flex-shrink: 0;
        "
        aria-hidden="true"
      ></span>
      <span class="t-metadata" style="color: var(--color-text-muted);">Diego / AI</span>
    </div>

    <!-- Messages area -->
    <div
      style="min-height: 12rem; margin-bottom: 1.5rem;"
      data-chat-messages
      aria-live="polite"
      aria-relevant="additions text"
    >
      <!-- Welcome message -->
      <div
        style="
          display: flex;
          gap: 0.75rem;
          align-items: flex-start;
          margin-bottom: 1.25rem;
        "
      >
        <span class="t-metadata" style="color: var(--color-text-muted); margin-top: 0.25rem; flex-shrink: 0;">Diego</span>
        <p
          class="t-body-small"
          style="
            color: var(--color-text-secondary);
            line-height: 1.7;
          "
        >
          {welcome}
        </p>
      </div>
    </div>

    <!-- Status label -->
    <p
      style="
        display: none;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-muted);
        letter-spacing: 0.06em;
        margin-bottom: 0.75rem;
      "
      data-chat-status
      role="status"
    ></p>

    <!-- Input form -->
    <form
      style="border-top: 1px solid var(--color-border); padding-top: 1rem;"
      data-chat-form
      onsubmit="return false;"
    >
      <label class="sr-only" for="chat-question">{inputLabel}</label>
      <div
        style="
          display: flex;
          gap: 0.75rem;
          align-items: flex-end;
        "
      >
        <input
          id="chat-question"
          name="question"
          type="text"
          autocomplete="off"
          required
          maxlength="1000"
          placeholder={placeholder}
          style="
            flex: 1;
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--color-border);
            padding: 0.5rem 0;
            font-family: var(--font-sans);
            font-size: 0.9375rem;
            color: var(--color-text-primary);
            outline: none;
            transition: border-color 150ms ease-out;
          "
          data-chat-input
        />
        <button
          type="submit"
          style="
            background: none;
            border: 1px solid var(--color-border);
            color: var(--color-text-secondary);
            padding: 0.375rem 0.875rem;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
            transition: color 150ms ease-out, border-color 150ms ease-out;
            flex-shrink: 0;
            line-height: 1.5;
          "
          data-chat-submit
        >
          {sendLabel}
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  import { initializeChat } from '../scripts/chat-client';

  initializeChat();
  document.addEventListener('astro:page-load', initializeChat);
</script>

<style>
  /* Focus state for the input */
  [data-chat-input]:focus {
    border-bottom-color: var(--color-text-secondary);
  }

  /* Hover state for button */
  [data-chat-submit]:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  [data-chat-submit]:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* User message styling injected by chat-client */
  [data-chat-messages] .chat-user-msg {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    justify-content: flex-end;
  }

  [data-chat-messages] .chat-user-msg p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  [data-chat-messages] .chat-ai-msg {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  [data-chat-messages] .chat-ai-msg p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
</style>

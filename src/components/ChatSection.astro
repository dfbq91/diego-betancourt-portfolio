---
interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  welcome: string;
  inputLabel: string;
  placeholder: string;
  sendLabel: string;
  typingLabel: string;
  errorMessage: string;
  limitMessage: string;
}

const {
  title,
  eyebrow,
  intro,
  welcome,
  inputLabel,
  placeholder,
  sendLabel,
  typingLabel,
  errorMessage,
  limitMessage
} = Astro.props;
---

<section id="chat" class="scroll-mt-16 px-4 py-16 md:px-8" aria-labelledby="chat-title">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 max-w-xl">
      <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">
        {eyebrow}
      </p>
      <h2 id="chat-title" class="text-2xl font-bold text-gray-900 md:text-3xl">{title}</h2>
      <p class="mt-3 text-sm leading-6 text-gray-600 md:text-base">{intro}</p>
    </div>

    <div
      class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-[0_18px_45px_-32px_rgba(15,23,42,0.55)]"
      data-chat
      data-typing-label={typingLabel}
      data-error-message={errorMessage}
      data-limit-message={limitMessage}
    >
      <div class="flex items-center gap-2 border-b border-slate-200 bg-white px-4 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Diego / AI</p>
      </div>

      <div class="min-h-64 space-y-4 p-4 md:min-h-72 md:p-6" data-chat-messages aria-live="polite" aria-relevant="additions text">
        <div class="max-w-[90%] rounded-2xl rounded-tl-sm bg-white px-4 py-3 text-sm leading-6 text-slate-700 shadow-sm ring-1 ring-slate-200">
          {welcome}
        </div>
      </div>

      <p class="hidden px-4 pb-3 text-sm text-slate-500 md:px-6" data-chat-status role="status"></p>

      <form class="border-t border-slate-200 bg-white p-3 md:p-4" data-chat-form onsubmit="return false;">
        <label class="sr-only" for="chat-question">{inputLabel}</label>
        <div class="flex items-center gap-2 rounded-xl border border-slate-300 bg-white p-1.5 shadow-sm transition focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100">
          <input
            id="chat-question"
            name="question"
            type="text"
            autocomplete="off"
            required
            maxlength="1000"
            placeholder={placeholder}
            class="min-w-0 flex-1 bg-transparent px-3 py-2 text-sm text-slate-900 outline-none placeholder:text-slate-400"
            data-chat-input
          />
          <button
            type="submit"
            class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-slate-900 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:opacity-50"
            data-chat-submit
          >
            <span class="hidden sm:inline">{sendLabel}</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { initializeChat } from '../scripts/chat-client';

  initializeChat();
  document.addEventListener('astro:page-load', initializeChat);
</script>

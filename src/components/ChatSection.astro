---
import { getLocale } from '../i18n/i18n';

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  welcome: string;
  inputLabel: string;
  placeholder: string;
  sendLabel: string;
  typingLabel: string;
  errorMessage: string;
  limitMessage: string;
}

const {
  title,
  eyebrow,
  intro,
  welcome,
  inputLabel,
  placeholder,
  sendLabel,
  typingLabel,
  errorMessage,
  limitMessage
} = Astro.props;

const locale = getLocale(Astro.url);

const suggestionPrompts = locale === 'en' ? [
  'what is your tech stack?',
  'are you available for hire?',
  'tell me about your background',
  'what distributed systems have you built?',
  'what are your hobbies?',
  'what is your favorite soccer team?'
] : [
  '¿cuál es tu stack técnico?',
  '¿estás disponible para trabajar?',
  'cuéntame sobre tu experiencia',
  '¿qué proyectos has desarrollado?',
  '¿cuáles son tus hobbies?',
  'cuál es el equipo de tus amores?'
];
---

<!-- ============================================================
     Corner crosshairs, macOS dots, interactive suggestion chips
     ============================================================ -->
<section
  id="chat"
  class="relative py-20 border-b border-[var(--border)] scroll-mt-20"
  aria-labelledby="chat-title"
>
  <div class="max-w-[1200px] mx-auto">
    <!-- Section Header -->
    <div class="flex items-baseline justify-between gap-6 mb-10 pb-5 border-b border-[var(--border)]">
      <div>
        <div class="font-mono text-[12px] text-[var(--text-dim)] tracking-[0.06em]">
          <span class="text-[var(--accent)] mr-2">04</span>{eyebrow || (locale === 'en' ? 'AI WORKSTATION' : 'ESTACIÓN IA')}
        </div>
        <h2
          id="chat-title"
          class="font-mono font-medium text-[clamp(26px,3.5vw,38px)] tracking-[-0.03em] text-[var(--text-bright)] mt-2 mb-0"
        >
          {title}
        </h2>
      </div>

      <div class="font-mono text-[12px] text-[var(--text-dim)] text-right hidden sm:block">
        ~/ask-me.sh<br />
        <span class="text-[var(--accent)]">● Cloudflare Workers AI & RAG</span>
      </div>
    </div>

    <!-- Intro Text -->
    <p class="text-[15px] text-[var(--text-dim)] max-w-[60ch] mb-8 font-mono">
      {intro}
    </p>

    <!-- Terminal Workstation Card -->
    <div
      class="relative bg-[var(--surface)] border border-[var(--border)] rounded-xl p-5 sm:p-6 flex flex-col min-h-[460px] shadow-[var(--shadow-card)]"
      data-chat
      data-typing-label={typingLabel}
      data-error-message={errorMessage}
      data-limit-message={limitMessage}
    >
      <!-- Cyberpunk Corner Brackets -->
      <span class="corner-bracket-tl"></span>
      <span class="corner-bracket-tr"></span>
      <span class="corner-bracket-bl"></span>
      <span class="corner-bracket-br"></span>

      <!-- Terminal Window Bar -->
      <div class="flex items-center justify-between font-mono text-[12px] text-[var(--text-dim)] border-b border-dashed border-[var(--border)] pb-3.5 mb-4">
        <div class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-full bg-[var(--border-strong)]"></span>
          <span class="size-2.5 rounded-full bg-[var(--border-strong)]"></span>
          <span class="size-2.5 rounded-full bg-[var(--accent)] shadow-[0_0_8px_var(--accent-glow)]"></span>
        </div>

        <span class="tracking-wider text-[var(--text-bright)]">~/ask-me.sh</span>

        <span class="flex items-center gap-1.5 text-[var(--accent)]">
          <span class="size-1.5 rounded-full bg-[var(--accent)] animate-blip-pulse"></span>
          ready
        </span>
      </div>

      <!-- Messages Stream Area -->
      <div
        class="overflow-y-auto flex flex-col gap-4 pt-1 px-1 pb-4 flex-grow max-h-[360px] min-h-[220px]"
        data-chat-messages
        aria-live="polite"
        aria-relevant="additions text"
      >
        <!-- Welcome message -->
        <div class="text-[14px] leading-relaxed max-w-[92%]">
          <div class="font-mono text-[11px] tracking-wider mb-1 text-[var(--text-dim)] select-none">
            // system
          </div>
          <div class="font-mono text-[var(--text)] whitespace-pre-wrap">
            {welcome}
          </div>
        </div>
      </div>

      <!-- Status Indicator Line -->
      <p
        class="hidden font-mono text-[11.5px] text-[var(--accent)] py-1 select-none animate-pulse"
        data-chat-status
        role="status"
      ></p>

      <!-- Quick Suggestion Chips -->
      <div class="flex flex-wrap gap-1.5 pt-3 pb-3 border-t border-dashed border-[var(--border)]">
        {suggestionPrompts.map((prompt) => (
          <button
            type="button"
            class="chat-suggestion-chip font-mono text-[11.5px] py-1 px-2.5 border border-[var(--border)] rounded-full bg-[var(--surface-2)] text-[var(--text-dim)] transition-colors duration-150 hover:text-[var(--accent)] hover:border-[var(--accent)] cursor-pointer select-none"
            data-suggestion={prompt}
          >
            {prompt}
          </button>
        ))}
      </div>

      <!-- Terminal Input Form -->
      <form
        class="relative mt-1"
        data-chat-form
        onsubmit="return false;"
      >
        <label class="sr-only" for="chat-question">{inputLabel}</label>
        <div class="flex items-center gap-2 py-2 px-3 bg-[var(--surface-2)] border border-[var(--border)] rounded-lg transition-colors duration-150 focus-within:border-[var(--accent)]">
          <span class="font-mono text-[var(--accent)] text-[14px] select-none" aria-hidden="true">›</span>
          <input
            id="chat-question"
            name="question"
            type="text"
            autocomplete="off"
            required
            maxlength="1000"
            placeholder={placeholder}
            class="flex-1 min-w-0 font-mono text-[13px] text-[var(--text-bright)] bg-transparent border-none outline-none placeholder:text-[var(--text-faint)]"
            data-chat-input
          />
          <button
            type="submit"
            class="font-mono text-[11px] tracking-wider py-1 px-2 rounded border border-[var(--border-strong)] text-[var(--text-dim)] transition-colors duration-150 hover:text-[var(--accent)] hover:border-[var(--accent)] cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            data-chat-submit
          >
            <span class="hidden sm:inline">{sendLabel}&nbsp;</span>↵
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { initializeChat } from '../scripts/chat-client';

  initializeChat();
  document.addEventListener('astro:page-load', initializeChat);

  // Bind suggestion chips
  function bindChips() {
    document.querySelectorAll('.chat-suggestion-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-suggestion');
        const input = document.querySelector<HTMLInputElement>('[data-chat-input]');
        const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
        if (text && input && form) {
          input.value = text;
          form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
        }
      });
    });
  }

  bindChips();
  document.addEventListener('astro:page-load', bindChips);
</script>

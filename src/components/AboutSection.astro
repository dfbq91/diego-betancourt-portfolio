---
import { getLocale } from '../i18n/i18n';
import aboutEs from '../content/about/about.json';
import aboutEn from '../content/about/about.en.json';

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale(Astro.url);
const about = locale === 'en' ? aboutEn : aboutEs;

const paragraphs = about.bio.split('\n\n').filter(Boolean);
---

<!-- ============================================================
     HERO / ABOUT SECTION — T-7, T-8
     Editorial minimalism: large display type, generous negative space
     ============================================================ -->
<section
  id="about"
  class="scroll-mt-14 md:scroll-mt-0"
  style="
    padding: 5rem 2.5rem 4rem;
    border-bottom: 1px solid var(--color-border);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  "
  aria-labelledby="hero-heading"
>
  <!-- T-7: Hero — display-level positioning statement -->
  <div style="max-width: 52rem; margin-bottom: 4rem;">
    <p
      class="t-metadata"
      style="color: var(--color-text-muted); margin-bottom: 1.5rem; display: block;"
    >
      {locale === 'en' ? 'Software Engineer' : 'Ingeniero de Software'}
      &nbsp;//&nbsp;
      {locale === 'en' ? 'Colombia' : 'Colombia'}
    </p>

    <h1
      id="hero-heading"
      class="t-display"
      style="margin-bottom: 1.5rem;"
    >
      {about.name}
    </h1>

    <p
      style="
        font-size: clamp(1.125rem, 2.5vw, 1.375rem);
        line-height: 1.6;
        color: var(--color-text-secondary);
        max-width: 42rem;
        letter-spacing: -0.01em;
      "
    >
      {paragraphs[0]}
    </p>
  </div>

  <!-- T-8: About editorial grid -->
  <div
    style="
      border-top: 1px solid var(--color-border);
      padding-top: 2.5rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 52rem;
    "
  >
    <!-- Metadata row -->
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 1.5rem 3rem;
      "
    >
      <div>
        <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.375rem;">
          {locale === 'en' ? 'Location' : 'Ubicación'}
        </p>
        <p class="t-body-small" style="color: var(--color-text-secondary);">{about.location}</p>
      </div>
      <div>
        <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.375rem;">
          {locale === 'en' ? 'Focus' : 'Especialización'}
        </p>
        <p class="t-body-small" style="color: var(--color-text-secondary);">
          {locale === 'en' ? 'Full-Stack · Systems Architecture' : 'Full-Stack · Arquitectura de Sistemas'}
        </p>
      </div>
      <div>
        <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 0.375rem;">
          {locale === 'en' ? 'Availability' : 'Disponibilidad'}
        </p>
        <p class="t-body-small" style="color: var(--color-text-secondary);">
          {locale === 'en' ? 'Open to opportunities' : 'Abierto a oportunidades'}
        </p>
      </div>
    </div>

    <!-- Additional paragraphs -->
    {paragraphs.slice(1).map((para) => (
      <p class="t-body" style="max-width: 52rem;">
        {para}
      </p>
    ))}
  </div>
</section>

---
import { getLocale } from '../i18n/i18n';
import aboutEs from '../content/about/about.json';
import aboutEn from '../content/about/about.en.json';

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale(Astro.url);
const about = locale === 'en' ? aboutEn : aboutEs;
---

<section id="about" class="py-16 px-4 md:px-8 scroll-mt-16">
  <h2 data-i18n="about" class="text-2xl font-bold text-gray-900 mb-8 pb-2 border-b border-gray-200">
    {title}
  </h2>
  <div class="space-y-6">
    <div>
      <h3 class="text-xl font-semibold text-gray-900">{about.name}</h3>
      <p class="text-gray-500 text-sm flex items-center gap-2 mt-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {about.location}
      </p>
    </div>
    <div class="prose max-w-none text-gray-600">
      {about.bio.split('\n\n').map((paragraph) => (
        <p class="mb-4">{paragraph}</p>
      ))}
    </div>
  </div>
</section>

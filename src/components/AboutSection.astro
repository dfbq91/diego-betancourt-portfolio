---
import { getLocale } from '../i18n/i18n';
import aboutEs from '../content/about/about.json';
import aboutEn from '../content/about/about.en.json';
import config from '../data/config.json';

interface Props {
  title: string;
}

const locale = getLocale(Astro.url);
const about = locale === 'en' ? aboutEn : aboutEs;
---

<!-- ============================================================
     Terminal prompt headline, status blip, command actions & specs
     ============================================================ -->
<section
  id="about"
  class="relative pt-12 pb-20 md:pt-20 md:pb-28 border-b border-[var(--border)] scroll-mt-20"
  aria-labelledby="hero-heading"
>
  <div class="max-w-[1200px] mx-auto">
    <!-- Top Status Badge -->
    <div class="inline-flex items-center gap-2.5 font-mono text-[12px] tracking-[0.04em] text-[var(--text-dim)] py-1 px-3 border border-[var(--border)] rounded-full bg-[var(--surface)] mb-7 whitespace-nowrap">
      <span
        class="size-2 rounded-full bg-[var(--accent)] shadow-[0_0_10px_var(--accent-glow)] animate-blip-pulse inline-block shrink-0"
        aria-hidden="true"
      ></span>
      <span>{locale === 'en' ? 'Open to remote/hybrid and on-site opportunities' : 'Abierto a trabajo remoto/híbrido y presencial'}</span>
    </div>

    <!-- Main Terminal Greeting Headline -->
    <h1
      id="hero-heading"
      class="font-mono font-medium text-[clamp(34px,5.5vw,68px)] leading-[1.05] tracking-[-0.04em] mt-0 mb-4 text-[var(--text-bright)]"
    >
      <span class="text-[var(--text-faint)] font-light select-none">$ </span>{locale === 'en' ? 'hi, I\'m' : 'Hola, soy'} <span class="text-[var(--accent)]">{about.name}</span><span class="inline-block w-[0.52ch] h-[0.9em] bg-[var(--accent)] ml-1 align-baseline animate-blink" aria-hidden="true"></span>
    </h1>

    <!-- Monospace Role Subtitle -->
    <p class="font-mono text-[14px] text-[var(--text-dim)] tracking-tight mt-0 mb-6">
      {locale === 'en'
        ? 'Full-Stack Software Engineer | Software Architecture, AWS Cloud & AI Systems'
        : 'Ingeniero de Software Full-Stack | Arquitectura de Software, AWS Cloud & IA'}
    </p>

    <!-- Bio Statement with Accented Highlights -->
    <p class="text-[17px] leading-[1.7] text-[var(--text)] max-w-[62ch] mt-0 mb-8 text-pretty">
      {locale === 'en' ? (
        <>
          I build and ship <em class="text-[var(--accent)] not-italic font-medium">production software end-to-end</em>: resilient backend microservices, modern reactive web platforms, and intelligent agentic workflows. With <em class="text-[var(--accent)] not-italic font-medium">6+ years</em> in software engineering, I specialize in architecting performant, observable, and delightful developer and user experiences.
        </>
      ) : (
        <>
          Construyo y despliego <em class="text-[var(--accent)] not-italic font-medium">software de producción de extremo a extremo</em>: microservicios escalables, aplicaciones web modernas e integraciones con IA y sistemas distribuidos. Con más de <em class="text-[var(--accent)] not-italic font-medium">6 años de experiencia</em>, me enfoco en crear arquitecturas confiables, código limpio y experiencias interactivas excepcionales.
        </>
      )}
    </p>

    <!-- Action Buttons Group -->
    <div class="flex flex-wrap gap-3 items-center mb-12">
      <!-- Contact Button -->
      <a href={`/?lang=${locale}#contact`} class="btn-accent">
        <span>→</span>
        <span>{locale === 'en' ? 'get in touch' : 'contáctame'}</span>
      </a>

      <!-- Projects Button -->
      <a
        href={`/?lang=${locale}#projects`}
        class="btn-secondary"
        aria-label={locale === 'en' ? 'View portfolio' : 'Ver portafolio'}
      >
        <span class="text-[var(--text-faint)] select-none">$</span>
        <span>ls projects/</span>
      </a>

      <!-- Social Icon Buttons -->
      <div class="flex items-center gap-2 sm:ml-auto">
        <a
          href={config.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="grid place-items-center w-9 h-9 border border-[var(--border-strong)] rounded-lg text-[var(--text-bright)] bg-[var(--surface)] transition-all duration-180 hover:border-[var(--accent)] hover:text-[var(--accent)]"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.13v3.16c0 .31.21.68.79.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"></path>
          </svg>
        </a>

        <a
          href={config.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="grid place-items-center w-9 h-9 border border-[var(--border-strong)] rounded-lg text-[var(--text-bright)] bg-[var(--surface)] transition-all duration-180 hover:border-[var(--accent)] hover:text-[var(--accent)]"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5 1.13 1 2.5 1s2.48 1.12 2.48 2.5M.22 8h4.56v14H.22zm7.5 0h4.37v1.91h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7V22h-4.56v-6.61c0-1.58-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.49V22H7.72z"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Terminal Specs Key-Value Grid -->
    <div class="pt-8 border-t border-dashed border-[var(--border)] grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="flex flex-col gap-1">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
          // {locale === 'en' ? 'location' : 'ubicación'}
        </span>
        <span class="font-mono text-[13px] text-[var(--text-bright)]">{about.location} · GMT-5</span>
      </div>

      <div class="flex flex-col gap-1">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
          // {locale === 'en' ? 'focus' : 'especialidad'}
        </span>
        <span class="font-mono text-[13px] text-[var(--text-bright)]">{locale === 'en' ? 'Full-Stack & Software Architecture' : 'Full-Stack & Arquitectura de Software'}</span>
      </div>

      <div class="flex flex-col gap-1">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
          // {locale === 'en' ? 'experience' : 'experiencia'}
        </span>
        <span class="font-mono text-[13px] text-[var(--text-bright)]">{locale === 'en' ? '6+ years' : '6+ años'}</span>
      </div>

      <div class="flex flex-col gap-1">
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
          // {locale === 'en' ? 'status' : 'estado'}
        </span>
        <span class="font-mono text-[13px] text-[var(--accent)] flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-[var(--accent)]"></span>
          {locale === 'en' ? 'open to opportunities' : 'abierto a oportunidades'}
        </span>
      </div>
    </div>
  </div>
</section>

---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import AboutSection from '../components/AboutSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ChatSection from '../components/ChatSection.astro';
import CvSection from '../components/CvSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/i18n';

const t = getTranslations(Astro.url);
---

<Base title="Diego Betancourt — Software Engineer" description={t.meta.description}>
  <Navigation />

  <main id="main-content" class="relative z-10 max-w-[1200px] mx-auto w-full px-6 sm:px-8 flex-grow">
    <AboutSection title={t.about.title} />
    <ExperienceSection title={t.experience.title} presentLabel={t.experience.present} />
    <ProjectsSection title={t.projects.title} demoLabel={t.projects.demo} repoLabel={t.projects.repo} />
    <ChatSection
      title={t.chat.title}
      eyebrow={t.chat.eyebrow}
      intro={t.chat.intro}
      welcome={t.chat.welcome}
      inputLabel={t.chat.inputLabel}
      placeholder={t.chat.placeholder}
      sendLabel={t.chat.send}
      typingLabel={t.chat.typing}
      errorMessage={t.chat.error}
      limitMessage={t.chat.limit}
    />
    <CvSection title={t.Resume.title} downloadLabel={t.Resume.download} />
    <ContactSection
      title={t.contact.title}
      linkedinLabel={t.contact.linkedin}
      githubLabel={t.contact.github}
      emailLabel={t.contact.email}
      emailCardLabel={t.contact.emailCard}
      emailSubjectLabel={t.contact.emailSubject}
      emailMessageLabel={t.contact.emailMessage}
      emailSendLabel={t.contact.emailSend}
      emailSendingLabel={t.contact.emailSending}
      emailSuccessMessage={t.contact.emailSuccess}
      emailErrorMessage={t.contact.emailError}
      emailCloseLabel={t.contact.emailClose}
      emailSubjectPlaceholder={t.contact.emailSubjectPlaceholder}
      emailMessagePlaceholder={t.contact.emailMessagePlaceholder}
    />
  </main>

  <Footer />
</Base>

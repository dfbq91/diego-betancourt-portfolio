---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getLocale, getTranslations } from '../../i18n/i18n';
import { getStaticPosts, type BlogPost } from '../../utils/blog';

const t = getTranslations(Astro.url);

const allPosts = await getCollection('blog');
function getPostsForLocale(locale: 'es' | 'en'): BlogPost[] {
  const collectionPosts: BlogPost[] = allPosts
  .filter((post) => post.data.lang === locale)
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    date: post.data.date,
    excerpt: post.data.excerpt || post.body.slice(0, 150) + '...',
    slug: post.id,
    lang: post.data.lang,
    isStatic: false,
  }));

  const staticPosts = getStaticPosts().filter((post) => post.lang === locale);
  return [...collectionPosts, ...staticPosts].sort(
    (a, b) => b.date.valueOf() - a.date.valueOf()
  );
}

const postsByLocale = { es: getPostsForLocale('es'), en: getPostsForLocale('en') };

function formatDate(date: Date, loc: string): string {
  return date.toLocaleDateString(loc === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={`${t.blog.title} - Diego Betancourt`} description={t.meta.description}>
  <Navigation />

  <main class="md:ml-64 pt-16 md:pt-0 min-h-screen">
    <section class="py-16 px-4 md:px-8">
      <h1 data-i18n="blog" class="text-3xl font-bold text-gray-900 mb-8 pb-2 border-b border-gray-200">
        {t.blog.title}
      </h1>

      {(['es', 'en'] as const).map((locale) => (
        <div data-language-content={locale} class="grid gap-6 md:grid-cols-2">
          {postsByLocale[locale].map((post) => (
            <BlogCard
              title={post.title}
              excerpt={post.excerpt}
              date={post.date}
              slug={post.slug}
              lang={locale}
              dateFormat={formatDate(post.date, locale)}
            />
          ))}
        </div>
      ))}
    </section>
  </main>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import { getLocale, getTranslations } from '../../i18n/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return allPosts.map((post) => ({
    params: { post: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const locale = getLocale(Astro.url);
const t = getTranslations(Astro.url);

const { Content } = await render(post);

function formatDate(date: Date, loc: string): string {
  return date.toLocaleDateString(loc === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={`${post.data.title} — Diego Betancourt`} description={post.data.excerpt}>
  <Navigation />

  <main
    style="padding-top: 3.5rem;"
    id="post-main"
  >
    <script is:inline>
      function setPostOffset() {
        const main = document.getElementById('post-main');
        if (!main) return;
        if (window.innerWidth >= 768) {
          main.style.marginLeft = '15rem';
          main.style.paddingTop = '0';
        } else {
          main.style.marginLeft = '0';
          main.style.paddingTop = '3.5rem';
        }
      }
      setPostOffset();
      window.addEventListener('resize', setPostOffset);
    </script>

    <article
      style="
        padding: 4rem 2.5rem 6rem;
        max-width: calc(15rem + 52rem);
      "
    >
      <!-- Article header -->
      <header style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border);">
        <p class="t-metadata" style="color: var(--color-text-muted); margin-bottom: 1rem;">
          <a
            href={`/blog?lang=${locale}`}
            style="color: var(--color-text-muted); text-decoration: none; transition: color 150ms ease-out;"
          >
            Blog
          </a>
          &nbsp;/&nbsp;
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date, locale)}
          </time>
        </p>

        <h1 class="t-h1" style="margin-bottom: 1rem; max-width: 44rem;">
          {post.data.title}
        </h1>

        <div style="display: flex; align-items: center; gap: 1rem;">
          <span class="t-metadata" style="color: var(--color-text-muted);">{post.data.author}</span>
        </div>
      </header>

      <!-- Article body — editorial prose -->
      <div class="prose-editorial" style="max-width: 68ch;">
        <Content />
      </div>

      <!-- Article footer -->
      <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <a
          href={`/blog?lang=${locale}`}
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--color-text-muted);
            transition: color 150ms ease-out;
          "
        >
          <span class="t-metadata">←</span>
          <span class="t-label" data-i18n="backToBlog">
            {locale === 'en' ? 'Back to Blog' : 'Volver al Blog'}
          </span>
        </a>
      </footer>
    </article>
  </main>
</Base>

# Environment variables — Chat RAG (specs/002-portfolio-IA-deploy)
# Copy this file to .env and fill in values as needed. Never commit .env.
#
# Non-secret runtime vars (question limit, model IDs, top-K) live in
# wrangler.toml [vars] and are read by /api/chat at runtime.

# --- Build-time only (scripts/build-rag-index.ts) ---

# Cloudflare API token used ONLY at build time to generate embeddings via the
# Workers AI REST API (plan D6). Required by `npm run build` (prebuild script).
# SECRET — never prefix with PUBLIC_, never commit, only set as a secret in CI/Cloudflare Pages.
CF_EMBEDDINGS_API_TOKEN=

# Cloudflare account ID, required together with the token for the REST API.
CLOUDFLARE_ACCOUNT_ID=

# Optional override of the Cloudflare REST API base URL (testing/enterprise proxies).
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
